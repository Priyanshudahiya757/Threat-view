# Copy this file to .env and fill in real values. Never commit .env.

# --- Flask ---
SECRET_KEY=change-this-to-a-long-random-string
FLASK_ENV=development

# --- JWT ---
# Uses SECRET_KEY as fallback if not set. Set this independently in production.
JWT_SECRET_KEY=change-this-to-another-long-random-string
JWT_ACCESS_TOKEN_EXPIRES=900
JWT_REFRESH_TOKEN_EXPIRES=604800

# --- Database ---
# PostgreSQL is the target database; SQLAlchemy also accepts sqlite:///
# URLs for quick local testing without a Postgres server running.
DATABASE_URL=postgresql://threatview_user:threatview_pass@localhost:5432/threatview

# --- AlienVault OTX (https://otx.alienvault.com) ---
# Sign in -> profile menu -> API keys.
OTX_API_KEY=

# --- PhishTank (https://www.phishtank.com/developer_info.php) ---
# Anonymous access is heavily rate limited. Register for a free
# application key and use your personal keyed feed URL for reliable
# scheduled ingestion. If you do not have a key yet, the anonymous feed
# is still supported.
PHISHTANK_APP_KEY=
PHISHTANK_URL=https://data.phishtank.com/data/online-valid.json

# --- URLhaus / abuse.ch (https://auth.abuse.ch/) ---
# All abuse.ch APIs require a free Auth-Key; requests without one are
# rejected with a 401. URLHAUS_API_KEY is accepted as a compatibility
# alias if you already use that variable name.
URLHAUS_URL=https://urlhaus-api.abuse.ch/v1/urls/recent
URLHAUS_AUTH_KEY=your-abuse-ch-auth-key-here
URLHAUS_API_KEY=

# --- Scheduler (optional, sensible defaults shown) ---
SCHEDULER_ENABLED=true
INGESTION_INTERVAL_MINUTES=60
HTTP_TIMEOUT_SECONDS=15

# --- Sample data bootstrap (optional) ---
SEED_SAMPLE_DATA=true

# --- CORS (optional) ---
# Comma-handling isn't implemented for multiple origins yet -- set to a
# single origin (e.g. http://localhost:3000) or leave as * for now.
CORS_ORIGINS=*

# --- Logging (optional) ---
LOG_LEVEL=INFO
